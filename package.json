{
  "name": "figma-mcp-bridge",
  "private": true,
  "workspaces": [
    "server",
    "plugin"
  ],
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "3.9.6"
  },
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "check": "bun run --filter '*' typecheck && bun run --filter '*' build && bun run format:check",
    "build": "bun run --filter '*' build"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
